<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Safari (WebKit) on macOS. One-time setup: run "sudo safaridriver" with the enable flag (see README). No headless mode. -->
<suite name="02 Cross-browser - safari" parallel="none">
    <listeners>
        <listener class-name="com.qaportfolio.core.listeners.RetryTransformer"/>
    </listeners>
    <test name="safari desktop-fhd 1920x1080">
        <parameter name="browser" value="safari"/>
        <parameter name="viewport" value="1920x1080"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="safari laptop 1366x768">
        <parameter name="browser" value="safari"/>
        <parameter name="viewport" value="1366x768"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="safari tablet 768x1024">
        <parameter name="browser" value="safari"/>
        <parameter name="viewport" value="768x1024"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="safari phone 390x844">
        <parameter name="browser" value="safari"/>
        <parameter name="viewport" value="390x844"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
</suite>
