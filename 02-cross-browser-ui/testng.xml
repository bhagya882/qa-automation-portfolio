<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- PR suite: Chrome + Firefox, desktop + phone viewport. Run headless: -Dheadless=true -->
<suite name="02 Cross-browser - PR" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="com.qaportfolio.core.listeners.RetryTransformer"/>
    </listeners>
    <test name="chrome 1366x768">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewport" value="1366x768"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="chrome 390x844">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewport" value="390x844"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="firefox 1366x768">
        <parameter name="browser" value="firefox"/>
        <parameter name="viewport" value="1366x768"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
    <test name="firefox 390x844">
        <parameter name="browser" value="firefox"/>
        <parameter name="viewport" value="390x844"/>
        <classes>
            <class name="com.qaportfolio.crossbrowser.ResponsiveJourneyTest"/>
            <class name="com.qaportfolio.crossbrowser.VisualConsistencyTest"/>
        </classes>
    </test>
</suite>
