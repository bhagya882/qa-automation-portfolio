  "info": {
    "_postman_id": "91e5062e-f611-5cab-a30f-3e58b6c08b30",
    "name": "DemoShop API Regression (DummyJSON)",
    "description": "Project 03 regression collection. Target: https://dummyjson.com (public fake API for testing). Run with Newman: `npm test` inside 03-api-testing. Folder 'Known defects' is expected to FAIL and is run separately with `npm run test:defects`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level checks applied to every request",
          "pm.test(\"Response time below \" + pm.environment.get(\"maxResponseMs\") + \" ms\", () => pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get(\"maxResponseMs\") || 3000)));",
          "if (pm.response.code !== 404 || pm.response.headers.get('Content-Type').includes('json')) {",
          "  pm.test(\"Content-Type is JSON\", () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - valid credentials",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"expiresInMins\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const schema = {\"type\": \"object\", \"required\": [\"id\", \"username\", \"email\", \"accessToken\", \"refreshToken\"], \"properties\": {\"id\": {\"type\": \"integer\"}, \"username\": {\"type\": \"string\"}, \"email\": {\"type\": \"string\"}, \"accessToken\": {\"type\": \"string\"}, \"refreshToken\": {\"type\": \"string\"}}};",
                  "pm.test(\"Login response matches JSON schema\", () => pm.response.to.have.jsonSchema(schema));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Access token is a JWT\", () => pm.expect(body.accessToken.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"Username echoes request\", () => pm.expect(body.username).to.eql(pm.environment.get(\"username\")));",
                  "// Chain: save tokens + user id for later requests (runtime only, never committed)",
                  "pm.environment.set(\"accessToken\", body.accessToken);",
                  "pm.environment.set(\"refreshToken\", body.refreshToken);",
                  "pm.environment.set(\"userId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user (/auth/me) with token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Returns the logged-in user\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.environment.get(\"userId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Login sets HttpOnly accessToken/refreshToken cookies; the cookie jar would silently authenticate this",
                  "// request, so clear it to really test the \"no credentials\" path.",
                  "const jar = pm.cookies.jar();",
                  "jar.unset(pm.environment.get(\"baseUrl\"), \"accessToken\", () => {});",
                  "jar.unset(pm.environment.get(\"baseUrl\"), \"refreshToken\", () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Error message is \\\"Access Token is required\\\"\", () => pm.expect(pm.response.json().message).to.eql(\"Access Token is required\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user with garbage token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer garbage"
