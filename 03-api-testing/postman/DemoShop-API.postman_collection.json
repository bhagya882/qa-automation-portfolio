    {
      "name": "Carts",
      "item": [
        {
          "name": "Get cart 1 - totals consistent",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/carts/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const schema = {\"type\": \"object\", \"required\": [\"id\", \"products\", \"total\", \"discountedTotal\", \"userId\", \"totalProducts\", \"totalQuantity\"], \"properties\": {\"products\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"id\", \"price\", \"quantity\", \"total\"]}}}};",
                  "pm.test(\"Cart matches JSON schema\", () => pm.response.to.have.jsonSchema(schema));",
                  "",
                  "const c = pm.response.json();",
                  "pm.test(\"Line total = price x quantity\", () => c.products.forEach(l => pm.expect(l.total).to.be.closeTo(l.price * l.quantity, 0.01)));",
                  "pm.test(\"Cart total = sum of lines\", () => pm.expect(c.total).to.be.closeTo(c.products.reduce((s, l) => s + l.total, 0), 0.01));",
                  "pm.test(\"totalQuantity = sum of quantities\", () => pm.expect(c.totalQuantity).to.eql(c.products.reduce((s, l) => s + l.quantity, 0)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Carts of logged-in user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
