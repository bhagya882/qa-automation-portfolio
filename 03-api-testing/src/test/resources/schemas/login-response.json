{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "POST /auth/login response",
  "type": "object",
  "required": ["id", "username", "email", "firstName", "lastName", "accessToken", "refreshToken"],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "username": {"type": "string", "minLength": 1},
    "email": {"type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$"},
    "firstName": {"type": "string"},
    "lastName": {"type": "string"},
    "gender": {"type": "string"},
    "image": {"type": "string"},
    "accessToken": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},
    "refreshToken": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}
  }
}
