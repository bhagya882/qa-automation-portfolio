<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.qaportfolio</groupId>
        <artifactId>qa-automation-portfolio</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>05-performance</artifactId>
    <name>05 Performance and Load Testing (JMeter DSL)</name>

    <properties>
        <perf.profile>smoke</perf.profile>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.qaportfolio</groupId>
            <artifactId>qa-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.qaportfolio</groupId>
            <artifactId>sample-app</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- sample-app's installed POM is shade-reduced, so its runtime deps are declared here -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>us.abstracta.jmeter</groupId>
            <artifactId>jmeter-java-dsl</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- JMeter ships its own logging binding; avoid duplicate SLF4J providers with qa-core -->
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <perf.profile>${perf.profile}</perf.profile>
                        <allure.results.directory>${project.basedir}/../target/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
