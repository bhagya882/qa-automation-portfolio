<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- PR-safe performance suite: load, stress, spike, endurance. Known defects (PERF-001) are excluded. -->
<suite name="05 Performance" verbose="1">
    <listeners>
        <listener class-name="com.qaportfolio.core.listeners.RetryTransformer"/>
    </listeners>
    <test name="performance">
        <groups>
            <run>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="com.qaportfolio.perf.LoadTest"/>
            <class name="com.qaportfolio.perf.StressTest"/>
            <class name="com.qaportfolio.perf.SpikeTest"/>
            <class name="com.qaportfolio.perf.EnduranceTest"/>
        </classes>
    </test>
</suite>
