    <suppress until="2027-03-31Z">
        <notes>Justification, ticket, owner</notes>
        <packageUrl regex="true">^pkg:maven/org\.example/lib@.*$</packageUrl>
        <cve>CVE-0000-00000</cve>
    </suppress>
    -->
</suppressions>
