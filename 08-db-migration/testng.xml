<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="08-db-migration" verbose="1">
    <listeners>
        <listener class-name="com.qaportfolio.core.listeners.RetryTransformer"/>
        <listener class-name="com.qaportfolio.db.support.DbReport"/>
    </listeners>
    <test name="migration-validation" preserve-order="true">
        <classes>
            <class name="com.qaportfolio.db.tests.SchemaValidationTest"/>
            <class name="com.qaportfolio.db.tests.DataQualityTest"/>
            <class name="com.qaportfolio.db.tests.ReconciliationTest"/>
            <class name="com.qaportfolio.db.tests.IdempotencyTest"/>
            <class name="com.qaportfolio.db.tests.RollbackTest"/>
            <class name="com.qaportfolio.db.tests.TransactionRollbackTest"/>
        </classes>
    </test>
</suite>
